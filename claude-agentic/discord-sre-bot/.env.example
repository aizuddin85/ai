# ── Required ───────────────────────────────────────────────────────────────────

# Discord bot token — get it from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# Anthropic API key — get it from https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Optional ───────────────────────────────────────────────────────────────────

# Comma-separated Discord server (guild) IDs to restrict the bot to.
# Leave empty to register commands globally (can take up to 1 hour to propagate).
# Specify guild IDs for instant command registration during development.
# ALLOWED_GUILD_IDS=123456789012345678,987654321098765432

# Set to "1" to show full tool-call output for /ask and /nodes commands.
# /healthcheck and /upgrade always show tool calls.
# VERBOSE_TOOLS=0
