# ============================================================
# AKS Health MCP Server - Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# ----------------------------------------------------------------
# Azure Tenant
# Find it: Azure Portal → Azure Active Directory → Overview → "Tenant ID"
# ⚠ Must be a valid UUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
# ----------------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# ----------------------------------------------------------------
# Azure Subscriptions to query (comma-separated GUIDs)
# Find them: Azure Portal → Subscriptions → "Subscription ID"
# Single subscription:
#   AZURE_SUBSCRIPTION_IDS=11111111-1111-1111-1111-111111111111
# Multiple subscriptions:
#   AZURE_SUBSCRIPTION_IDS=11111111-...,22222222-...
# ----------------------------------------------------------------
AZURE_SUBSCRIPTION_IDS=11111111-1111-1111-1111-111111111111

# ----------------------------------------------------------------
# Azure AD App Registration
# The app registration used for the React frontend SSO.
# AZURE_AD_APP_CLIENT_ID : Application (client) ID of the registration.
# AZURE_CLIENT_SECRET    : Client secret of the SAME registration.
#                          Required for the On-Behalf-Of (OBO) token
#                          exchange that makes Azure API calls run as
#                          the signed-in user (their Azure RBAC applies).
#                          Leave blank to fall back to `az login` or
#                          Workload Identity (no OBO).
# Find client ID: Azure Portal → App registrations → your app → "Application (client) ID"
# Create secret : Azure Portal → App registrations → your app → Certificates & secrets
# ----------------------------------------------------------------
AZURE_AD_APP_CLIENT_ID=22222222-2222-2222-2222-222222222222
AZURE_CLIENT_SECRET=

# ----------------------------------------------------------------
# Official Microsoft AKS MCP Server  (github.com/Azure/aks-mcp)
# Run `make install-aks-mcp` to download the binary to ./bin/aks-mcp.
# ----------------------------------------------------------------
# Path to the aks-mcp binary (defaults to 'aks-mcp' if it is on PATH)
AKS_MCP_BINARY=./bin/aks-mcp
# Access level: readonly (default) | readwrite | admin
AKS_MCP_ACCESS_LEVEL=readonly

# ----------------------------------------------------------------
# Azure AI Foundry (for agents)
# Endpoint: your project's inference URL, e.g.
#   https://<project-name>.services.ai.azure.com/models
# Auth reuses the Azure credential chain (OBO token → az login → Workload Identity).
# Set AZURE_FOUNDRY_API_KEY only if you prefer key-based auth over Azure AD.
# ----------------------------------------------------------------
AZURE_FOUNDRY_ENDPOINT=https://<project>.services.ai.azure.com/models
# REQUIRED – the model deployment name in your Azure AI Foundry project (e.g. gpt-4o)
AZURE_FOUNDRY_MODEL=
AZURE_FOUNDRY_API_KEY=

# ----------------------------------------------------------------
# Frontend / CORS
# FRONTEND_ORIGIN: REQUIRED – the React app's public URL (used for CORS).
#   Local dev  : http://localhost:5173
#   Production : https://aks-health.contoso.com
# ----------------------------------------------------------------
FRONTEND_ORIGIN=
API_HOST=0.0.0.0
API_PORT=8000

# ----------------------------------------------------------------
# Logging
# ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
