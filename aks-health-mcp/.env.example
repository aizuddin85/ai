# ============================================================
# AKS Health MCP Server - Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# ----------------------------------------------------------------
# Azure Authentication
# For SERVICE PRINCIPAL (robotic/CI):
#   Set all three below.
# For USER / LOCAL execution:
#   Leave blank - the server will use AzureCliCredential
#   (run `az login` before starting the server).
# ----------------------------------------------------------------
# ⚠ Replace 00000000-... with your real Tenant ID GUID (must be a valid UUID format)
# Find it: Azure Portal → Azure Active Directory → Overview → "Tenant ID"
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Default subscription to query (can be overridden per-tool call)
# Find it: Azure Portal → Subscriptions → copy "Subscription ID" (UUID format)
AZURE_SUBSCRIPTION_ID=11111111-1111-1111-1111-111111111111

# ----------------------------------------------------------------
# Kubernetes Authentication
# For IN-CLUSTER execution the server auto-detects the ServiceAccount.
# For LOCAL execution, point to your kubeconfig.
# ----------------------------------------------------------------
# Leave blank to use ~/.kube/config default
KUBECONFIG=
# Override the active context
K8S_CONTEXT=
# Force in-cluster mode (true/false)
K8S_IN_CLUSTER=false

# ----------------------------------------------------------------
# MCP Server Settings
# ----------------------------------------------------------------
# Transport: stdio (default) | sse
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8090
# Request timeout seconds for Azure/K8s API calls
API_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------
# Azure AI Foundry (for agents)
# Endpoint: your project's inference URL, e.g.
#   https://<project-name>.services.ai.azure.com/models
# Auth reuses the same Azure credential chain above (SP or az login).
# Set AZURE_FOUNDRY_API_KEY only if you prefer key-based auth over Azure AD.
# ----------------------------------------------------------------
AZURE_FOUNDRY_ENDPOINT=https://<project>.services.ai.azure.com/models
AZURE_FOUNDRY_MODEL=gpt-4o
AZURE_FOUNDRY_API_KEY=

# ----------------------------------------------------------------
# Frontend API backend – Azure AD SSO enforcement
# AZURE_AD_APP_CLIENT_ID : Client ID of the app registration used for
#                          the React frontend SSO (may differ from the SP).
# AZURE_AD_ALLOWED_GROUP : Object ID of the security group whose members
#                          are authorised to use the dashboard.
# FRONTEND_ORIGIN        : The React app's public URL (CORS).
# ----------------------------------------------------------------
# Find it: Azure Portal → Azure Active Directory → App registrations → your app → "Application (client) ID"
AZURE_AD_APP_CLIENT_ID=22222222-2222-2222-2222-222222222222
# Find it: Azure Portal → Azure Active Directory → Groups → your group → "Object ID"
AZURE_AD_ALLOWED_GROUP=33333333-3333-3333-3333-333333333333
FRONTEND_ORIGIN=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000

# ----------------------------------------------------------------
# Logging
# ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
