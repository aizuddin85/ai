# ============================================================
# AKS Health MCP Server - Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# ----------------------------------------------------------------
# Azure Authentication
# For SERVICE PRINCIPAL (robotic/CI):
#   Set all three below.
# For USER / LOCAL execution:
#   Leave blank - the server will use AzureCliCredential
#   (run `az login` before starting the server).
# ----------------------------------------------------------------
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Default subscription to query (can be overridden per-tool call)
AZURE_SUBSCRIPTION_ID=your-subscription-id

# ----------------------------------------------------------------
# Kubernetes Authentication
# For IN-CLUSTER execution the server auto-detects the ServiceAccount.
# For LOCAL execution, point to your kubeconfig.
# ----------------------------------------------------------------
# Leave blank to use ~/.kube/config default
KUBECONFIG=
# Override the active context
K8S_CONTEXT=
# Force in-cluster mode (true/false)
K8S_IN_CLUSTER=false

# ----------------------------------------------------------------
# MCP Server Settings
# ----------------------------------------------------------------
# Transport: stdio (default) | sse
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8090
# Request timeout seconds for Azure/K8s API calls
API_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------
# Azure AI Foundry (for agents)
# Endpoint: your project's inference URL, e.g.
#   https://<project-name>.services.ai.azure.com/models
# Auth reuses the same Azure credential chain above (SP or az login).
# Set AZURE_FOUNDRY_API_KEY only if you prefer key-based auth over Azure AD.
# ----------------------------------------------------------------
AZURE_FOUNDRY_ENDPOINT=https://<project>.services.ai.azure.com/models
AZURE_FOUNDRY_MODEL=gpt-4o
AZURE_FOUNDRY_API_KEY=

# ----------------------------------------------------------------
# Logging
# ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
