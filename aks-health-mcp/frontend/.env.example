# -------------------------------------------------------
# AKS Health UI – Environment Variables
# Copy to .env and fill in values. Never commit .env.
# -------------------------------------------------------

# Azure AD app registration (same as AZURE_AD_APP_CLIENT_ID on the backend)
VITE_AZURE_AD_CLIENT_ID=your-app-registration-client-id
VITE_AZURE_AD_TENANT_ID=your-tenant-id

# Object ID of the authorised sysadmin security group
VITE_AZURE_AD_ALLOWED_GROUP=your-sysadmin-group-object-id

# Backend API base URL (leave blank in dev – Vite proxy handles /api)
VITE_API_BASE_URL=

# App name shown in the UI header
VITE_APP_NAME=AKS Health Dashboard
