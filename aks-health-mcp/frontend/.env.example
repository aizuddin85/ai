# -------------------------------------------------------
# AKS Health UI – Environment Variables
# Copy to .env and fill in values. Never commit .env.
# -------------------------------------------------------

# Azure AD app registration (same as AZURE_AD_APP_CLIENT_ID on the backend)
# ⚠ Replace with your actual GUIDs from Azure Portal (must be UUID format)
# Azure Portal → Azure Active Directory → App registrations → your app → "Application (client) ID"
VITE_AZURE_AD_CLIENT_ID=22222222-2222-2222-2222-222222222222
# Azure Portal → Azure Active Directory → Overview → "Tenant ID"
VITE_AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000

# Backend API base URL (leave blank in dev – Vite proxy handles /api)
VITE_API_BASE_URL=

# App name shown in the UI header
VITE_APP_NAME=AKS Health Dashboard
